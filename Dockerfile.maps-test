# syntax=docker/dockerfile:1
FROM node:22-trixie-slim AS application
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN node --check server.cjs && node --check app.js && node --check google-maps.cjs && npm test

# Same pinned engine used by Mahanaicoach/google-maps-scraper-kit.
# This image already includes the matching Playwright driver and Chromium.
FROM gosom/google-maps-scraper:v1.18.1
WORKDIR /app
COPY --from=application /usr/local/bin/node /usr/local/bin/node
COPY --from=application /app /app
ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=160 \
    PROSPECT_TEST_MODE=true \
    BUSINESS_PROVIDER=google-maps \
    AUTH_MODE=basic \
    DISABLE_TELEMETRY=1 \
    GOMEMLIMIT=160MiB \
    GOMAXPROCS=1
ENTRYPOINT ["node", "scripts/start-maps-test.cjs"]
